# =============================================================================
# Copiá este archivo a  .env  y completá los valores.
#   cp .env.example .env
# NUNCA subas .env al repo (ya está en .gitignore).
# =============================================================================

# ----------------------------- Dynatrace ------------------------------------
# URL de tu tenant de plataforma (Fase 1). Ej: https://abc12345.apps.dynatrace.com
DT_ENVIRONMENT=https://<env-id>.apps.dynatrace.com

# Platform token para el MCP (lectura: problems, logs, DQL). Prefijo dt0s16.
# Scopes sugeridos: storage:*:read, environment-api, davis-copilot (según server MCP)
DT_PLATFORM_TOKEN=dt0s16.XXXXXXXX.YYYYYYYY

# Tope de gasto de Grail por query, en GB (protege el trial).
DT_GRAIL_QUERY_BUDGET_GB=1

# Ingesta OTLP hacia Dynatrace (Fase 3, fan-out del colector).
# Endpoint OTLP v2. Verificá el host exacto de tu tenant en la Fase 1.
DT_OTLP_ENDPOINT=https://<env-id>.live.dynatrace.com/api/v2/otlp
# API token de ingesta (prefijo dt0c01.). Scopes:
#   openTelemetryTrace.ingest, logs.ingest, metrics.ingest
DT_API_TOKEN=dt0c01.XXXXXXXX.YYYYYYYY

# ----------------------------- Anthropic ------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Modelo Claude a usar por los agentes (ajustá según tu acceso).
ANTHROPIC_MODEL=claude-sonnet-4-5

# ----------------------------- Phoenix --------------------------------------
# Endpoint OTLP HTTP de Phoenix (para verificación directa; los agentes en
# realidad exportan al colector, no aquí).
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# ----------------------------- Agentes --------------------------------------
# Dónde exportan OTLP los agentes: el colector (gestionado por BindPlane).
OTEL_COLLECTOR_HTTP=http://localhost:4318

# ----------------------------- BindPlane (Fase 2) ---------------------------
# Licencia GRATUITA desde https://bindplane.com/download
BINDPLANE_LICENSE=
BINDPLANE_USERNAME=admin
BINDPLANE_PASSWORD=change-me
# Generá un UUID:  uuidgen  (o python -c "import uuid;print(uuid.uuid4())")
BINDPLANE_SESSION_SECRET=00000000-0000-0000-0000-000000000000
BINDPLANE_REMOTE_URL=http://localhost:3001
